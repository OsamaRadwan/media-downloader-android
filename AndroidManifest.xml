        <service android:name=".DownloadService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".OverlayAccessibilityService" android:label="Media Downloader" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/overlay_accessibility_service" />
        </service>
    </application>
</manifest>
